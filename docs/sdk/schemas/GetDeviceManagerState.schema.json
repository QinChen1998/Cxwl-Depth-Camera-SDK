{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GetDeviceManagerState",
  "type": "object",
  "properties": {
    "busy": {
      "type": "boolean",
      "description": "内部会话／后台操作忙。"
    },
    "can_manage": {
      "type": "boolean",
      "description": "无采集句柄且管理器空闲。"
    },
    "usb": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "description": "idle/checking/ready/network_required/update_required/registration_required/enrolling/enrolled/using_saved_device/cancelled/error。业务用检查 ID 和状态共同判断。"
        },
        "check_id": {
          "type": "integer",
          "minimum": 0,
          "description": "有效 USB 检查 ID；0 表示无有效检查。按 64 位整数读取。"
        },
        "phase": {
          "type": "string",
          "description": "诊断阶段字符串；可新增。无检查对象时省略。"
        },
        "error": {
          "type": "string",
          "description": "诊断文本，成功时可为空；无检查对象时省略。"
        },
        "runtime_replaced": {
          "type": "boolean",
          "description": "是否替换运行文件。"
        },
        "attachment_id": {
          "type": "string",
          "description": "接入指纹，不透明值。"
        },
        "host_authorization_id": {"type": "string", "description": "每台相机和当前 Windows 用户的主机授权标识。"},
        "known": {
          "type": "boolean",
          "description": "发现时是否已登记。"
        },
        "absent": {
          "type": "boolean",
          "description": "是否未发现 USB。"
        }
      },
      "required": [
        "state",
        "check_id"
      ],
      "additionalProperties": true,
      "not": { "required": ["device_id"] },
      "description": "USB 状态；管理器不含 device_id。"
    },
    "maintenance": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "description": "idle/running/ready/error。必须检查 ready 才能判断维护成功。"
        },
        "exit_code": {
          "type": "integer",
          "description": "Worker 退出码；完成后出现，-1 表示启动／异常失败。"
        },
        "error": {
          "type": "string",
          "description": "错误说明；错误或完成后出现，可为空。"
        },
        "archived_rollbacks": {
          "type": "integer",
          "minimum": 0,
          "description": "成功归档的旧副本数；完成回执中出现。"
        },
        "runtime_replaced": {
          "type": "boolean",
          "description": "是否替换当前载荷；完成回执中出现。"
        }
      },
      "required": [
        "state"
      ],
      "additionalProperties": true
    },
    "recovery": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "idle",
            "running",
            "ready",
            "error"
          ],
          "description": "恢复状态；ready 表示设备可以重新连接。"
        },
        "error": {
          "type": "string",
          "description": "完成后的错误说明，成功时为空。"
        },
        "exit_code": {
          "type": "integer"
        },
        "faults_cleared": {
          "type": "boolean"
        },
        "cleared_fault_count": {
          "type": "integer",
          "minimum": 0
        },
        "board_archive": {
          "type": "string",
          "description": "板端保留的故障证据目录。"
        },
        "runtime_replaced": {
          "type": "boolean"
        }
      },
      "required": [
        "state"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "busy",
    "can_manage",
    "usb",
    "maintenance",
    "recovery"
  ],
  "additionalProperties": true
}
