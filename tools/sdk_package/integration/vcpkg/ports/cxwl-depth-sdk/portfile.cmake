vcpkg_check_linkage(ONLY_DYNAMIC_LIBRARY)
if(NOT VCPKG_TARGET_IS_WINDOWS OR NOT VCPKG_TARGET_ARCHITECTURE STREQUAL "x64")
  message(FATAL_ERROR "CXWL SDK supports Windows x64 only")
endif()
if(DEFINED ENV{CXWL_SDK_ROOT} AND NOT "$ENV{CXWL_SDK_ROOT}" STREQUAL "")
  file(TO_CMAKE_PATH "$ENV{CXWL_SDK_ROOT}" CXWL_PACKAGE)
  if(NOT IS_ABSOLUTE "${CXWL_PACKAGE}")
    message(FATAL_ERROR "CXWL_SDK_ROOT must be an absolute SDK package path")
  endif()
else()
  get_filename_component(CXWL_PACKAGE "${CURRENT_PORT_DIR}/../../../.." ABSOLUTE)
endif()
if(NOT EXISTS "${CXWL_PACKAGE}/sdk-manifest.json" OR NOT EXISTS "${CXWL_PACKAGE}/SDK/include/DepthSdk.h")
  message(FATAL_ERROR "Set CXWL_SDK_ROOT to the complete SDK package and pass it through the vcpkg triplet")
endif()
file(READ "${CXWL_PACKAGE}/sdk-manifest.json" metadata)
string(JSON version GET "${metadata}" sdk_version)
file(READ "${CURRENT_PORT_DIR}/vcpkg.json" port_metadata)
string(JSON port_version GET "${port_metadata}" version)
if(NOT version STREQUAL port_version)
  message(FATAL_ERROR "The overlay and SDK binary version must match")
endif()
set(profile MINIMAL)
if("capture" IN_LIST FEATURES)
  set(profile STANDARD)
endif()
if("viewer" IN_LIST FEATURES)
  set(profile FULL)
endif()
set(VCPKG_BUILD_TYPE release)
find_program(CXWL_CMAKE cmake REQUIRED)
file(MAKE_DIRECTORY "${CURRENT_BUILDTREES_DIR}/${TARGET_TRIPLET}")
vcpkg_execute_required_process(
  COMMAND "${CXWL_CMAKE}" -S "${CXWL_PACKAGE}/SDK" -B "${CURRENT_BUILDTREES_DIR}/${TARGET_TRIPLET}"
    -G "Visual Studio 17 2022" -A x64 "-DCMAKE_INSTALL_PREFIX=${CURRENT_PACKAGES_DIR}"
    "-DCXWL_RUNTIME_PROFILE=${profile}"
  WORKING_DIRECTORY "${CURRENT_BUILDTREES_DIR}" LOGNAME configure-${TARGET_TRIPLET})
vcpkg_execute_required_process(
  COMMAND "${CXWL_CMAKE}" --install "${CURRENT_BUILDTREES_DIR}/${TARGET_TRIPLET}" --config Release
  WORKING_DIRECTORY "${CURRENT_BUILDTREES_DIR}" LOGNAME install-${TARGET_TRIPLET})
file(MAKE_DIRECTORY "${CURRENT_PACKAGES_DIR}/share/${PORT}")
file(COPY_FILE "${CURRENT_PACKAGES_DIR}/bin/licenses/ProductLicense.txt"
  "${CURRENT_PACKAGES_DIR}/share/${PORT}/copyright")
set(VCPKG_POLICY_DLLS_WITHOUT_LIBS enabled)
set(VCPKG_POLICY_ALLOW_EXES_IN_BIN enabled)
set(VCPKG_POLICY_MISMATCHED_NUMBER_OF_BINARIES enabled)
