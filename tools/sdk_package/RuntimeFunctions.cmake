function(cxwl_runtime_files output profile)
  string(TOUPPER "${profile}" profile)
  if(NOT profile MATCHES "^(MINIMAL|STANDARD|FULL)$")
    message(FATAL_ERROR "Runtime PROFILE must be MINIMAL, STANDARD or FULL")
  endif()
  include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/RuntimeComponents.cmake")
  set(files "${CXWL_RUNTIME_${profile}_FILES}")
  set(${output} "${files}" PARENT_SCOPE)
endfunction()

function(cxwl_deploy_runtime target)
  cmake_parse_arguments(CXWL "" "PROFILE;DESTINATION" "" ${ARGN})
  if(CXWL_UNPARSED_ARGUMENTS)
    message(FATAL_ERROR "Unknown cxwl_deploy_runtime arguments: ${CXWL_UNPARSED_ARGUMENTS}")
  endif()
  if(NOT CXWL_PROFILE)
    set(CXWL_PROFILE STANDARD)
  endif()
  cxwl_runtime_files(files "${CXWL_PROFILE}")
  if(CXWL_KEYWORDS_MISSING_VALUES)
    message(FATAL_ERROR "Missing cxwl_deploy_runtime value: ${CXWL_KEYWORDS_MISSING_VALUES}")
  endif()
  if(NOT CXWL_DESTINATION)
    set(destination "$<TARGET_FILE_DIR:${target}>")
  elseif(IS_ABSOLUTE "${CXWL_DESTINATION}" OR CXWL_DESTINATION MATCHES "^\\$<")
    set(destination "${CXWL_DESTINATION}")
  else()
    set(destination "$<TARGET_FILE_DIR:${target}>/${CXWL_DESTINATION}")
  endif()
  add_custom_command(TARGET ${target} POST_BUILD
    COMMAND "${CMAKE_COMMAND}" "-DSOURCE=${CxwlDepthSdk_RUNTIME_DIR}"
      "-DDESTINATION=${destination}" "-DPROFILE=${CXWL_PROFILE}"
      -P "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/DeployRuntime.cmake"
    VERBATIM)
endfunction()

function(cxwl_install_runtime)
  cmake_parse_arguments(CXWL "" "DESTINATION;PROFILE;COMPONENT" "" ${ARGN})
  if(CXWL_UNPARSED_ARGUMENTS)
    message(FATAL_ERROR "Unknown cxwl_install_runtime arguments")
  endif()
  if(NOT CXWL_DESTINATION)
    set(CXWL_DESTINATION bin)
  endif()
  if(NOT CXWL_PROFILE)
    set(CXWL_PROFILE STANDARD)
  endif()
  if(NOT CXWL_COMPONENT)
    set(CXWL_COMPONENT Runtime)
  endif()
  cxwl_runtime_files(files "${CXWL_PROFILE}")
  foreach(file IN LISTS files)
    get_filename_component(parent "${file}" DIRECTORY)
    install(FILES "${CxwlDepthSdk_RUNTIME_DIR}/${file}"
      DESTINATION "${CXWL_DESTINATION}/${parent}" COMPONENT "${CXWL_COMPONENT}")
  endforeach()
endfunction()
