if(NOT WIN32 OR (DEFINED CMAKE_SIZEOF_VOID_P AND NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
    OR (CMAKE_VS_PLATFORM_NAME AND NOT CMAKE_VS_PLATFORM_NAME STREQUAL "x64")
    OR CMAKE_C_COMPILER_ARCHITECTURE_ID MATCHES "^(ARM|ARM64|ARM64EC)$"
    OR CMAKE_CXX_COMPILER_ARCHITECTURE_ID MATCHES "^(ARM|ARM64|ARM64EC)$")
  set(CxwlDepthSdk_FOUND FALSE)
  set(CxwlDepthSdk_NOT_FOUND_MESSAGE "CXWL Depth SDK requires Windows x64 (x86-64)")
  return()
endif()
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/CxwlDepthSdkTargets.cmake")
  get_filename_component(CxwlDepthSdk_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
else()
  get_filename_component(CxwlDepthSdk_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
endif()
set(CxwlDepthSdk_RUNTIME_DIR "${CxwlDepthSdk_ROOT}/bin")
if(NOT TARGET CXWL::Runtime)
  add_library(CXWL::Runtime SHARED IMPORTED GLOBAL)
  set_target_properties(CXWL::Runtime PROPERTIES
    IMPORTED_LOCATION "${CxwlDepthSdk_ROOT}/bin/CxwlDepthSdk.dll"
    IMPORTED_IMPLIB "${CxwlDepthSdk_ROOT}/lib/CxwlDepthSdk.lib"
    INTERFACE_INCLUDE_DIRECTORIES "${CxwlDepthSdk_ROOT}/include")
endif()
if(NOT TARGET CXWL::DepthSdk)
  if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/CxwlDepthSdkTargets.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/CxwlDepthSdkTargets.cmake")
  else()
    add_library(CXWL::DepthSdk INTERFACE IMPORTED GLOBAL)
    set_property(TARGET CXWL::DepthSdk PROPERTY INTERFACE_LINK_LIBRARIES CXWL::Runtime)
    if(MSVC)
      set_property(TARGET CXWL::DepthSdk PROPERTY INTERFACE_COMPILE_OPTIONS /utf-8)
    endif()
  endif()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/RuntimeFunctions.cmake")
