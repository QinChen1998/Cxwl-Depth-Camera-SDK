if(NOT IS_DIRECTORY "${SOURCE}" OR NOT DESTINATION)
  message(FATAL_ERROR "Invalid SDK runtime deployment path")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/RuntimeFunctions.cmake")
cxwl_runtime_files(files "${PROFILE}")
foreach(file IN LISTS files)
  if(NOT EXISTS "${SOURCE}/${file}")
    message(FATAL_ERROR "Runtime file is missing: ${file}")
  endif()
  get_filename_component(directory "${DESTINATION}/${file}" DIRECTORY)
  file(MAKE_DIRECTORY "${directory}")
  file(COPY_FILE "${SOURCE}/${file}" "${DESTINATION}/${file}" ONLY_IF_DIFFERENT)
endforeach()
