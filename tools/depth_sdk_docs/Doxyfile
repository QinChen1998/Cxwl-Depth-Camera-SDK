PROJECT_NAME = "RGBD深度相机 C/C++ SDK"
PROJECT_NUMBER = "$(CXWL_DOC_VERSION)"
OUTPUT_LANGUAGE = Chinese
OUTPUT_DIRECTORY = "$(CXWL_DOC_OUTPUT)"
INPUT = "$(CXWL_DOC_ROOT)/sdk/DepthSdk.h" "$(CXWL_DOC_ROOT)/sdk/DepthSdkVersion.h" "$(CXWL_DOC_ROOT)/docs/sdk"
FILE_PATTERNS = *.h *.md
RECURSIVE = YES
USE_MDFILE_AS_MAINPAGE = "$(CXWL_DOC_ROOT)/docs/sdk/index.md"
EXAMPLE_PATH = "$(CXWL_DOC_ROOT)/sdk" "$(CXWL_DOC_ROOT)/sdk/examples" "$(CXWL_DOC_ROOT)/docs/sdk/schemas"
EXAMPLE_RECURSIVE = YES
EXAMPLE_PATTERNS = *.c *.cpp *.json
EXTRACT_ALL = NO
EXCLUDE_SYMBOLS = CXWL_DEPTH_LAYOUT
OPTIMIZE_OUTPUT_FOR_C = YES
FULL_PATH_NAMES = YES
STRIP_FROM_PATH = "$(CXWL_DOC_ROOT)/sdk/" "$(CXWL_DOC_ROOT)/docs/sdk/"
JAVADOC_AUTOBRIEF = YES
ENABLE_PREPROCESSING = YES
MACRO_EXPANSION = YES
PREDEFINED = CXWL_DEPTH_API= CXWL_DEPTH_CALL= "CXWL_DEPTH_DEPRECATED(message)=" "CXWL_DEPTH_LAYOUT(name,condition)=" _WIN32=1 _M_X64=100
GENERATE_HTML = YES
HTML_OUTPUT = .
HTML_COLORSTYLE = AUTO_LIGHT
GENERATE_TREEVIEW = NO
DISABLE_INDEX = NO
HTML_DYNAMIC_MENUS = YES
SEARCHENGINE = YES
SOURCE_BROWSER = NO
INLINE_SOURCES = NO
GENERATE_LATEX = NO
GENERATE_XML = YES
XML_OUTPUT = xml
HAVE_DOT = NO
WARN_IF_UNDOCUMENTED = NO
WARN_IF_DOC_ERROR = YES
WARN_AS_ERROR = YES
WARN_LOGFILE = "$(CXWL_DOC_OUTPUT)/warnings.log"
QUIET = YES
