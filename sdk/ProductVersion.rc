#pragma code_page(65001)
#include <windows.h>
#include "DepthSdkVersion.h"
#ifndef CXWL_BINARY_NAME
#define CXWL_BINARY_NAME "CxwlDepthSdk.dll"
#endif
#ifndef CXWL_BINARY_TYPE
#define CXWL_BINARY_TYPE VFT_DLL
#endif
#ifndef CXWL_FILE_DESCRIPTION
#define CXWL_FILE_DESCRIPTION CXWL_DEPTH_PRODUCT_NAME " C/C++ SDK"
#endif
1 VERSIONINFO
 FILEVERSION CXWL_DEPTH_FILE_VERSION
 PRODUCTVERSION CXWL_DEPTH_FILE_VERSION
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE CXWL_BINARY_TYPE
 FILESUBTYPE 0
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "080404b0"
  BEGIN
   VALUE "FileDescription", CXWL_FILE_DESCRIPTION "\0"
   VALUE "FileVersion", CXWL_DEPTH_FILE_VERSION_STRING "\0"
   VALUE "ProductName", CXWL_DEPTH_PRODUCT_NAME "\0"
   VALUE "ProductVersion", CXWL_DEPTH_VERSION "\0"
   VALUE "LegalCopyright", CXWL_DEPTH_COPYRIGHT "\0"
   VALUE "OriginalFilename", CXWL_BINARY_NAME "\0"
   VALUE "InternalName", CXWL_BINARY_NAME "\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0804, 1200
 END
END
